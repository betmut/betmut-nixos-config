{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "lock",
    "action" : "$NIXOS_CONFIG/hm-users/mathewelhans/config/hyprlock/launch-hyprlock.sh || hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
